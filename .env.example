# Local dev only. On Vercel (employers.hryantra.com) leave unset — the app uses /api/proxy automatically.
NEXT_PUBLIC_API_URL=http://localhost:5001/api/v1
NEXT_PUBLIC_API_BASE=http://localhost:5001

# Headquarters `/hq` UI — comma-separated emails allowed (default: admin@gmail.com if unset)
NEXT_PUBLIC_HQ_ALLOWED_EMAILS=admin@gmail.com

# Public backend origin for “register this redirect URI” hints (production)
NEXT_PUBLIC_BACKEND_PUBLIC_URL=

# Server-side proxy target (Vercel env). Production: https://api2.hryantra.com/api/v1
BACKEND_INTERNAL_URL=http://localhost:5001/api/v1

# Optional fallback if backend is down (same Cloudinary vars as backend — never commit real secrets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay checkout uses backend order API; key is returned from /subscription-plan/payment-order
# Ensure backend RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET are set and UPI ghodehimanshu453-4@okicici is linked in Razorpay Dashboard

# Bulk CV: distribute parse load across multiple API instances (same DB + tenant data required).
# NEXT_PUBLIC_BULK_CV_API_URLS=https://api2.hryantra.com/api/v1,https://api3.hryantra.com/api/v1
# Socket.IO must be enabled on each node; CORS must allow your Phase 2 origin.

# Bulk CV — single API defaults (no env needed): 2 parallel workers, server queue of 2, auto-retry.
# Only override if you need to tune:
# NEXT_PUBLIC_BULK_CV_CONCURRENCY=2
# NEXT_PUBLIC_BULK_CV_MAX_RETRIES=5
# NEXT_PUBLIC_BULK_CV_RETRY_DELAY_MS=2500
# NEXT_PUBLIC_BULK_CV_WORKER_STAGGER_MS=400
# NEXT_PUBLIC_LONG_RUNNING_FETCH_TIMEOUT_MS=600000
